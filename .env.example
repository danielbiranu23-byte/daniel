# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGODB_URI: Optional MongoDB Atlas connection string for persistent backend storage.
# Configure this in AI Studio Secrets or hosting Environment Variables (never commit real credentials).
MONGODB_URI=""
MONGODB_DB_NAME="qajeelcha_macaafaa"

# External MySQL (e.g. TiDB Cloud, Aiven, Railway, cPanel MySQL)
# Either provide MYSQL_URL (mysql://user:pass@host:port/dbname) OR individual MYSQL_* fields below.
MYSQL_URL=""
MYSQL_HOST=""
MYSQL_PORT="3306"
MYSQL_USER=""
MYSQL_PASSWORD=""
MYSQL_DATABASE="qajeelcha_macaafaa"
MYSQL_SSL="true"

# Supabase (Option 1: Connection Pooler Postgres URL — auto-creates tables)
SUPABASE_DB_URL=""
# Supabase (Option 2: HTTPS REST API — no password encoding needed)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

