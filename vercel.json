{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{data/bible/**,firebase-applet-config.json}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api", "destination": "/api/index?__vercel_path=" },
    { "source": "/api/(.*)", "destination": "/api/index?__vercel_path=$1" },
    { "source": "/((?!api(?:/|$)).*)", "destination": "/index.html" }
  ]
}
